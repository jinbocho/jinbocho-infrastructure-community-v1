# APISIX gateway -- environment template (used only with the optional
# docker-compose.apisix-overlay.yml in jinbocho-infrastructure-pro-v1;
# ADR-016 is still "Proposed, decision pending" -- this is a trial, not the
# default gateway).
# Copy to apisix-gateway.env and fill in your values:
#
#   cp envs/apisix-gateway.env.example envs/apisix-gateway.env
#
# envs/apisix-gateway.env is gitignored and never committed.

DEBUG=true

# Must be IDENTICAL to the value in auth-service.env, catalog-service.env,
# and ai-service.env -- this is what validates every token.
JWT_SECRET_KEY=YOUR_JWT_SECRET_KEY_HERE

# Comma-separated list of allowed origins, e.g.:
#   CORS_ORIGINS=http://localhost:5173,https://your-fe.onrender.com
# No "*" wildcard support: allow_credential:true + a wildcard origin is
# invalid CORS behaviour real browsers refuse regardless of gateway product.
CORS_ORIGINS=http://localhost:5173

# Must match auth-service's/catalog-service's/ai-service's JINBOCHO_FEATURES.
# Pro edition ships ai+kids by default. "community" (ADR-019/020 cross-library
# social, ADR-021's 2026-08-10 revision) is a separate optional module, off
# by default -- these trial gateway configs (ADR-016) do not yet implement
# the community route-gating the Python api-gateway does in main.py.
JINBOCHO_FEATURES=catalog,auth,ai,kids

# Request body size limit, bytes. Matches v1's default (10 MB).
MAX_BODY_SIZE=10485760

# Internal Docker network addresses -- do not change, these match the
# container names in docker-compose.community.local.yml /
# docker-compose.pro-local-overlay.yml.
AUTH_SERVICE_HOST=auth-service
AUTH_SERVICE_PORT=8001
CATALOG_SERVICE_HOST=catalog-service
CATALOG_SERVICE_PORT=8002
AI_SERVICE_HOST=ai-service
AI_SERVICE_PORT=8003
