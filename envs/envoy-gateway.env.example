# Envoy gateway -- environment template (used only with the optional
# docker-compose.envoy-overlay.yml in jinbocho-infrastructure-pro-v1;
# ADR-016 is still "Proposed, decision pending" -- this is a trial, not the
# default gateway).
# Copy to envoy-gateway.env and fill in your values:
#
#   cp envs/envoy-gateway.env.example envs/envoy-gateway.env
#
# envs/envoy-gateway.env is gitignored and never committed.

DEBUG=true

# Must be IDENTICAL to the value in auth-service.env, catalog-service.env,
# and ai-service.env -- this is what validates every token.
JWT_SECRET_KEY=YOUR_JWT_SECRET_KEY_HERE
JWT_ISSUER=jinbocho-auth
JWT_AUDIENCE=jinbocho

# Comma-separated list of allowed origins, e.g.:
#   CORS_ORIGINS=http://localhost:5173,https://your-fe.onrender.com
# No "*" wildcard support -- see the sibling apisix-gateway.env.example for
# why (invalid CORS behaviour with credentials, not a gateway limitation).
CORS_ORIGINS=http://localhost:5173

# Must match auth-service's/catalog-service's/ai-service's JINBOCHO_FEATURES.
# Pro edition ships ai+kids by default. "social" (ADR-019/020 cross-library
# social, "Comunità" in the frontend, ADR-021's 2026-08-10 revision; named
# "social" rather than "community" to avoid colliding with the edition name)
# is a separate optional module, off by default -- these trial gateway
# configs (ADR-016) do not yet implement the social route-gating the Python
# api-gateway does in main.py.
JINBOCHO_FEATURES=catalog,auth,ai,kids

# Request body size limit, bytes. Matches v1's default (10 MB).
MAX_BODY_SIZE=10485760

# Internal Docker network addresses -- do not change, these match the
# container names in docker-compose.community.local.yml /
# docker-compose.pro-local-overlay.yml.
AUTH_SERVICE_HOST=auth-service
AUTH_SERVICE_PORT=8001
CATALOG_SERVICE_HOST=catalog-service
CATALOG_SERVICE_PORT=8002
AI_SERVICE_HOST=ai-service
AI_SERVICE_PORT=8003

ENVOY_LOG_LEVEL=info
